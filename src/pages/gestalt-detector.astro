---
import SketchLayout from "../layouts/SketchLayout.astro";
import { SketchControlsWrapper } from "../components/ui/SketchControlsWrapper";
import { GestaltDetectorWrapper } from "../components/sketches/GestaltDetectorWrapper";
import type { SketchConfig } from "../types/sketch";

const config: SketchConfig = {
  id: "gestalt-detector",
  title: "Gestalt Detector",
  description: "Detects gestalt patterns in a point cloud.",
  seizureWarning: true,
  controls: [
    {
      id: "angleX",
      label: "Angle X",
      type: "range",
      min: -180,
      max: 180,
      step: 1,
      defaultValue: 0,
      tooltip: "Rotates the point cloud around the X axis (horizontal rotation)",
    },
    {
      id: "angleY",
      label: "Angle Y",
      type: "range",
      min: -180,
      max: 180,
      step: 1,
      defaultValue: 0,
      tooltip: "Rotates the point cloud around the Y axis (vertical rotation)",
    },
    {
      id: "angleZ",
      label: "Angle Z",
      type: "range",
      min: -180,
      max: 180,
      step: 1,
      defaultValue: 0,
      tooltip: "Rotates the point cloud around the Z axis (depth rotation)",
    },
    {
      id: "scale",
      label: "Scale",
      type: "range",
      min: 0.5,
      max: 2,
      step: 0.1,
      defaultValue: 1.0,
      tooltip: "Adjusts the overall size of the visualization",
    },
    {
      id: "nearMissDepth",
      label: "Near Miss Depth",
      type: "range",
      min: 0.0,
      max: 0.5,
      step: 0.01,
      defaultValue: 0.15,
      tooltip: "Controls how close points need to be to be considered part of the same shape pattern",
    },
  ],
  presets: [
    {
      name: "Default View",
      values: {
        angleX: 0,
        angleY: 0,
        angleZ: 0,
        scale: 1.0,
        nearMissDepth: 0.15,
      },
    },
    {
      name: "Top View",
      values: {
        angleX: 90,
        angleY: 0,
        angleZ: 0,
        scale: 1.0,
        nearMissDepth: 0.15,
      },
    },
  ],
};
---

<SketchLayout title={config.title} seizureWarning={config.seizureWarning} sketchId={config.id} config={config}>
  <SketchControlsWrapper client:load config={config} slot="controls" />
  <GestaltDetectorWrapper client:load slot="visualization" />
</SketchLayout>

<style>
  :global(canvas) {
    width: 100% !important;
    height: 100% !important;
  }
</style> 