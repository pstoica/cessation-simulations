---
import SketchLayout from "../layouts/SketchLayout.astro";
import { SketchControlsWrapper } from "../components/ui/SketchControlsWrapper.jsx";
import type { SketchConfig } from "../types/sketch";

const config: SketchConfig = {
  id: "coupled-kernels",
  title: "Coupled Kernels",
  description: "Visualization of coupled oscillators with various coupling strengths",
  seizureWarning: true,
  controls: [
    {
      id: "coupling1",
      label: "Coupling (1)",
      type: "range",
      defaultValue: 10.1,
      min: -20,
      max: 20,
      step: 0.1,
    },
    {
      id: "coupling2",
      label: "Coupling (2)",
      type: "range",
      defaultValue: 5.0,
      min: -20,
      max: 20,
      step: 0.1,
    },
    {
      id: "coupling3",
      label: "Coupling (3)",
      type: "range",
      defaultValue: 2.5,
      min: -20,
      max: 20,
      step: 0.1,
    },
    {
      id: "coupling4",
      label: "Coupling (4+)",
      type: "range",
      defaultValue: 1.0,
      min: -20,
      max: 20,
      step: 0.1,
    },
    {
      id: "couplingSmallWorld",
      label: "Small World",
      type: "range",
      defaultValue: 0.0,
      min: -20,
      max: 20,
      step: 0.1,
    },
  ],
  presets: [
    {
      name: "Strong Coupling",
      values: {
        coupling1: 15,
        coupling2: 10,
        coupling3: 5,
        coupling4: 2,
        couplingSmallWorld: 0,
      },
    },
    {
      name: "Weak Coupling",
      values: {
        coupling1: 5,
        coupling2: 2,
        coupling3: 1,
        coupling4: 0.5,
        couplingSmallWorld: 0,
      },
    },
  ],
};
---

<SketchLayout 
  title={config.title} 
  seizureWarning={config.seizureWarning}
  sketchId={config.id}
>
  <SketchControlsWrapper client:load config={config} slot="controls" />
  <div slot="visualization" id="canvas-container" style="width: 100%; height: 100%;">
    <canvas id="canvas"></canvas>
  </div>
</SketchLayout>

<style>
  :global(#canvas-container) {
    width: 100% !important;
    height: 100% !important;
  }
  
  :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    // Wait a tick to ensure canvas is ready
    await new Promise(resolve => setTimeout(resolve, 0));

    const canvas = document.getElementById("canvas") as HTMLCanvasElement;
    const container = document.getElementById("canvas-container")!;

    // Import the module once
    const { initialize, handleResize } = await import("../scripts/coupled-kernels.js");

    // Setup resize handler
    function resizeCanvas() {
      handleResize(canvas, container);
    }

    window.addEventListener("resize", resizeCanvas);
    resizeCanvas();

    // Initialize once
    initialize();
  });
</script>
