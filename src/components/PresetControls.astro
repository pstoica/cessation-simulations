---
import { Save, Download, Upload, ChevronDown } from "lucide-astro";

interface Preset {
  name: string;
  values: {
    coupling1: number;
    coupling2: number;
    coupling3: number;
    coupling4: number;
    smallWorld: number;
  };
}

const defaultPresets: Preset[] = [
  {
    name: "Wave Pattern",
    values: {
      coupling1: 10.1,
      coupling2: 5.0,
      coupling3: 2.5,
      coupling4: 1.0,
      smallWorld: 0.0,
    },
  },
  {
    name: "Spiral Formation",
    values: {
      coupling1: 18.5,
      coupling2: 4.7,
      coupling3: 2.5,
      coupling4: 4.4,
      smallWorld: -18.6,
    },
  },
];
---

<div class="preset-controls">
  <div class="select-wrapper">
    <select id="presetSelect">
      <option value="">Select Preset</option>
      {
        defaultPresets.map((preset) => (
          <option value={JSON.stringify(preset.values)}>{preset.name}</option>
        ))
      }
    </select>
    <ChevronDown class="select-icon" size={16} />
  </div>
  <button id="savePreset" title="Save Current">
    <Save size={16} />
  </button>
  <button id="exportPresets" title="Export All">
    <Download size={16} />
  </button>
  <input type="file" id="importPresets" accept=".json" style="display: none;" />
  <button id="importPresetsTrigger" title="Import">
    <Upload size={16} />
  </button>
</div>

<script define:vars={{ defaultPresets }}>
  const presetSelect = document.getElementById("presetSelect");
  const savePresetBtn = document.getElementById("savePreset");
  const exportPresetsBtn = document.getElementById("exportPresets");
  const importPresetsInput = document.getElementById("importPresets");
  const importPresetsTrigger = document.getElementById("importPresetsTrigger");

  // Load saved presets from localStorage
  const savedPresets = JSON.parse(
    localStorage.getItem("coupledKernelsPresets") || "[]"
  );
  savedPresets.forEach((preset) => {
    const option = document.createElement("option");
    option.value = JSON.stringify(preset.values);
    option.text = preset.name;
    presetSelect.appendChild(option);
  });

  function applyPreset(values) {
    Object.entries(values).forEach(([key, value]) => {
      const elementId = key === "smallWorld" ? "couplingSmallWorld" : key;
      const slider = document.getElementById(elementId);
      const valueDisplay = document.getElementById(`${elementId}Value`);

      if (slider) {
        slider.value = value.toString();
        if (valueDisplay) {
          valueDisplay.textContent = value.toString();
        }
        slider.dispatchEvent(new Event("input", { bubbles: true }));
        slider.dispatchEvent(new Event("change", { bubbles: true }));
      }
    });
  }

  function getCurrentValues() {
    return {
      coupling1: parseFloat(document.getElementById("coupling1").value),
      coupling2: parseFloat(document.getElementById("coupling2").value),
      coupling3: parseFloat(document.getElementById("coupling3").value),
      coupling4: parseFloat(document.getElementById("coupling4").value),
      smallWorld: parseFloat(
        document.getElementById("couplingSmallWorld").value
      ),
    };
  }

  function updatePresetOption(name, values) {
    // Look for existing option with this name
    let option = Array.from(presetSelect.options).find(
      (opt) => opt.text === name
    );

    if (option) {
      // Update existing option
      option.value = JSON.stringify(values);
    } else {
      // Create new option
      option = document.createElement("option");
      option.value = JSON.stringify(values);
      option.text = name;
      presetSelect.appendChild(option);
    }

    // Select the option by matching the name
    Array.from(presetSelect.options).forEach((opt) => {
      opt.selected = opt.text === name;
    });
  }

  function savePreset(name, values) {
    const savedPresets = JSON.parse(
      localStorage.getItem("coupledKernelsPresets") || "[]"
    );

    // Find existing preset index
    const existingIndex = savedPresets.findIndex((p) => p.name === name);

    if (existingIndex >= 0) {
      // Update existing preset
      savedPresets[existingIndex] = { name, values };
    } else {
      // Add new preset
      savedPresets.push({ name, values });
    }

    localStorage.setItem("coupledKernelsPresets", JSON.stringify(savedPresets));
    updatePresetOption(name, values);
  }

  presetSelect.addEventListener("change", () => {
    if (!presetSelect.value) return;
    const values = JSON.parse(presetSelect.value);
    applyPreset(values);
  });

  // Apply default preset if no selection
  if (!presetSelect.value && defaultPresets.length > 0) {
    presetSelect.value = JSON.stringify(defaultPresets[0].values);
    applyPreset(defaultPresets[0].values);
  }

  savePresetBtn.addEventListener("click", async () => {
    const name = await promptAsync("Enter preset name:");
    if (!name) return;

    const values = getCurrentValues();
    savePreset(name, values);
  });

  exportPresetsBtn.addEventListener("click", () => {
    const presets = JSON.parse(
      localStorage.getItem("coupledKernelsPresets") || "[]"
    );
    const blob = new Blob([JSON.stringify(presets, null, 2)], {
      type: "application/json",
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "coupled-kernels-presets.json";
    a.click();
    URL.revokeObjectURL(url);
  });

  importPresetsTrigger.addEventListener("click", () => {
    importPresetsInput.click();
  });

  importPresetsInput.addEventListener("change", (event) => {
    const file = event.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const presets = JSON.parse(e.target?.result);
        localStorage.setItem("coupledKernelsPresets", JSON.stringify(presets));
        location.reload();
      } catch (err) {
        alert("Invalid preset file");
      }
    };
    reader.readAsText(file);
  });

  function promptAsync(message) {
    return new Promise((resolve) => {
      resolve(prompt(message));
    });
  }
</script>

<style>
  .preset-controls {
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .select-wrapper {
    position: relative;
    flex: 1;
  }

  .select-icon {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #666;
  }

  select,
  button {
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
    color: #333;
    font-size: 0.9rem;
  }

  select {
    width: 100%;
    appearance: none;
    padding-right: 2rem;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
  }

  button:hover {
    background: #f0f0f0;
    border-color: #999;
  }

  select:focus,
  button:focus {
    outline: none;
    border-color: #666;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.1);
  }
</style>
