---
import "../../index.css";
import { SeizureWarning } from "../components/sketches/SeizureWarning";
import { FloatingControls } from "../components/ui/FloatingControls";
import type { SketchConfig } from "../types/sketch";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  seizureWarning?: boolean;
  sketchId: string;
  config: SketchConfig;
}

const { title, seizureWarning = false, sketchId, config } = Astro.props;

// Get all sketch routes and extract configs
const sketchFiles = await Astro.glob("../pages/*.astro");
const sketches = sketchFiles.filter(sketch => sketch.url !== '').map(sketch => ({
  url: sketch.url,
  // Extract name from URL: "/sketches/coupled-kernels" -> "Coupled Kernels"
  title: sketch.url.split('/').pop()?.replace('-', ' ')
    .split(' ').map(s => s.charAt(0).toUpperCase() + s.slice(1)).join(' ') || title
}));
---

<head>
  <ClientRouter />
  <meta charset="utf-8">
</head>

<div class="sketch-layout">
  <div class="visualization">
    {seizureWarning && <SeizureWarning client:load sketchId={sketchId} />}
    <slot name="visualization" />
  </div>

  <FloatingControls
    client:load
    title={title}
    config={config}
    sketches={sketches}
  >
    <slot name="controls" />
  </FloatingControls>
</div>

<ClientRouter />

<style>
  .sketch-layout {
    height: 100vh;
    position: relative;
  }

  .visualization {
    width: 100%;
    height: 100%;
    position: relative;
    background: black;
  }
</style>
