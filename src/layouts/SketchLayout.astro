---
import { SeizureWarning } from "../components/sketches/SeizureWarning";

interface Props {
  title: string;
  seizureWarning?: boolean;
  sketchId: string;
}

const { title, seizureWarning = false, sketchId } = Astro.props;

// Get all sketch routes and extract configs
const sketchFiles = await Astro.glob("../pages/sketches/*.astro");
const sketches = sketchFiles.map(sketch => ({
  url: sketch.url,
  // Extract name from URL: "/sketches/coupled-kernels" -> "Coupled Kernels"
  title: sketch.url.split('/').pop()?.replace('-', ' ')
    .split(' ').map(s => s.charAt(0).toUpperCase() + s.slice(1)).join(' ') || title
}));
---

<div class="sketch-layout">
  <div class="controls">
    <div class="sketch-selector">
      <select onChange="window.location.href = this.value">
        {sketches.map((sketch) => (
          <option 
            value={sketch.url} 
            selected={sketch.url.includes(title.toLowerCase().replace(" ", "-"))}
          >
            {sketch.title}
          </option>
        ))}
      </select>
      <div class="flex gap-2 mt-2">
        <button
          onclick="window.exportAllPresets()"
          class="flex-1 text-sm p-2 border rounded bg-white hover:bg-gray-50"
        >
          Export All Presets
        </button>
        <button
          onclick="document.getElementById('import-all').click()"
          class="flex-1 text-sm p-2 border rounded bg-white hover:bg-gray-50"
        >
          Import All Presets
        </button>
        <input
          type="file"
          id="import-all"
          accept=".json"
          class="hidden"
          onchange="window.importAllPresets(this.files[0]).then(() => window.location.reload())"
        />
      </div>
    </div>
    <div class="controls-container">
      <slot name="controls" />
    </div>
  </div>
  <div class="visualization">
    {seizureWarning && <SeizureWarning client:load sketchId={sketchId} />}
    <slot name="visualization" />
  </div>
</div>

<style>
  .sketch-layout {
    display: flex;
    height: 100vh;
  }

  .controls {
    width: 400px;
    background: #f5f5f5;
    border-right: 1px solid #ddd;
    overflow-y: auto;
  }

  .controls-container {
    padding: 1rem;
  }

  .sketch-selector {
    padding: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #ddd;
    background: white;
  }

  .sketch-selector select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1.1rem;
    background: white;
  }

  .visualization {
    flex: 1;
    position: relative;
    background: black;
  }
</style>

<script>
  import { exportAllPresets, importAllPresets } from '../lib/utils';
  window.exportAllPresets = exportAllPresets;
  window.importAllPresets = importAllPresets;
</script>
