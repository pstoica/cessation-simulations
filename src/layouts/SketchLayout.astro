---
import { SeizureWarning } from "../components/sketches/SeizureWarning";
import { SketchSelector } from "../components/sketches/SketchSelector";

interface Props {
  title: string;
  seizureWarning?: boolean;
  sketchId: string;
}

const { title, seizureWarning = false, sketchId } = Astro.props;

// Get all sketch routes and extract configs
const sketchFiles = await Astro.glob("../pages/*.astro");
const sketches = sketchFiles.filter(sketch => sketch.url !== '').map(sketch => ({
  url: sketch.url,
  // Extract name from URL: "/sketches/coupled-kernels" -> "Coupled Kernels"
  title: sketch.url.split('/').pop()?.replace('-', ' ')
    .split(' ').map(s => s.charAt(0).toUpperCase() + s.slice(1)).join(' ') || title
}));
---

<meta charset="utf-8">
<div class="sketch-layout">
  <div class="controls">
    <SketchSelector client:load sketches={sketches} currentTitle={title} />
    <div class="controls-container">
      <slot name="controls" />
    </div>
  </div>
  <div class="visualization">
    {seizureWarning && <SeizureWarning client:load sketchId={sketchId} />}
    <slot name="visualization" />
  </div>
</div>

<style>
  .sketch-layout {
    display: flex;
    height: 100vh;
  }

  .controls {
    width: 400px;
    background: #f5f5f5;
    border-right: 1px solid #ddd;
    overflow-y: auto;
  }

  .controls-container {
    padding: 1rem;
  }

  .visualization {
    flex: 1;
    position: relative;
    background: black;
  }
</style>
